            "title": "Year"
          },
          "cfo": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cfo",
            "description": "Cash from Operations (Operating Activity) in \u20b9 Cr"
          },
          "cfi": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cfi",
            "description": "Cash from Investing in \u20b9 Cr"
          },
          "cff": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cff",
