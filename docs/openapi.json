    "/api/v1/screener": {
      "get": {
        "tags": [
          "Screener"
        ],
        "summary": "Filter Universe (Screener Engine)",
        "description": "Multi-criteria screener matching Sprint 3 engine results. Query params: min_roe, max_de, min_fcf, min_opm, max_pe.",
        "operationId": "run_screener_query_api_v1_screener_get",
        "parameters": [
          {
            "name": "min_roe",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minimum ROE (%)",
              "title": "Min Roe"
            },
            "description": "Minimum ROE (%)"
          },
          {
            "name": "max_de",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Maximum Debt-to-Equity ratio",
              "title": "Max De"
            },
            "description": "Maximum Debt-to-Equity ratio"
          },
          {
            "name": "min_fcf",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minimum Free Cash Flow (INR Cr)",
              "title": "Min Fcf"
            },
            "description": "Minimum Free Cash Flow (INR Cr)"
          },
          {
            "name": "min_opm",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minimum Operating Profit Margin (%)",
              "title": "Min Opm"
            },
            "description": "Minimum Operating Profit Margin (%)"
          },
          {
            "name": "max_pe",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Maximum Price-to-Earnings multiple",
              "title": "Max Pe"
            },
            "description": "Maximum Price-to-Earnings multiple"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScreenerCompanyItem"
                  },
                  "title": "Response Run Screener Query Api V1 Screener Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
