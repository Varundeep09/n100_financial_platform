{
  "openapi": "3.1.0",
  "info": {
    "title": "N100 Financial Intelligence Platform API",
    "description": "Production-grade RESTful service exposing 16 endpoints for institutional fundamental intelligence, ratio analytics, screener filtering, peer comparisons, and sector benchmarking across the Nifty 100 universe.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/companies": {
      "get": {
        "tags": [
          "Companies"
        ],
        "summary": "List all 92 companies",
        "description": "Returns all 92 companies with ticker id, name, broad sector, peer group, and composite score.",
        "operationId": "get_companies_api_v1_companies_get",
        "parameters": [
          {
            "name": "sector",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by broad sector",
              "title": "Sector"
            },
            "description": "Filter by broad sector"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CompanySummary"
                  },
                  "title": "Response Get Companies Api V1 Companies Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
